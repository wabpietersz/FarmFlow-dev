{
  "name": "@farmflow/backend",
  "version": "1.0.0",
  "private": true,
  "description": "FarmFlow backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "jest --passWithNoTests",
    "test:integration": "jest -c jest.integration.config.js",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:treasury-sample": "tsx src/db/seedTreasurySample.ts",
    "db:reset": "tsx src/db/reset.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@farmflow/shared": "*",
    "@google-cloud/storage": "^8.2.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "7.5.0",
    "express-slow-down": "^2.1.0",
    "firebase-admin": "^14.5.0",
    "helmet": "8.0.0",
    "hpp": "^0.2.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.13",
    "postgres": "3.4.5",
    "uuid": "11.0.5",
    "winston": "3.17.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/hpp": "^0.2.7",
    "@types/jest": "29.5.14",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "drizzle-kit": "^0.31.11",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
